# Кеш Python. Шаблоны без **/ работают только в корне контекста,
# поэтому добавлены рекурсивные варианты для вложенных папок (app/__pycache__)
__pycache__/
**/__pycache__
*.pyc
**/*.pyc
*.pyo
**/*.pyo

# Система контроля версий
.git
.gitignore

# Виртуальные окружения
.venv/
venv/

# Секреты и логи
.env
*.log

# Файлы сборки и документация
Dockerfile*
README.md
