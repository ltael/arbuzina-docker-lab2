# ============================================
# Стадия 1: builder — установка зависимостей
# ============================================
FROM python:3.11-slim AS builder

WORKDIR /build

# Зависимости копируем отдельно от кода, чтобы слой кешировался
COPY requirements.txt .

# --no-cache-dir: pip не сохраняет скачанные пакеты в кеш
# --prefix=/install: библиотеки ставятся в отдельную папку,
# чтобы потом перенести только её в финальный образ
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ============================================
# Стадия 2: финальный образ
# ============================================
FROM python:3.11-slim

LABEL maintainer="arbuzina@lab.local"
LABEL version="2.0"

# Не создавать .pyc-файлы и не буферизовать вывод (логи сразу видны в docker logs)
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Переносим из builder только установленные библиотеки
COPY --from=builder /install /usr/local

# Копируем код приложения
COPY app/ ./app/

# Запуск не от root: создаём непривилегированного пользователя
RUN useradd --system --no-create-home appuser
USER appuser

EXPOSE 5468

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5468"]
